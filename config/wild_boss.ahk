; 获取所有BOSS等级分类
GetWildBossLevels() {
    return ["妖级", "地级", "天级", "自定义"]
}

; 根据等级获取地点列表
GetWildBossLocationsByLevel(level) {
    if (WildBossLocations.Has(level)) {
        return WildBossLocations[level]
    }
    return []
}

; 获取所有可用地点（扁平化）
GetAllWildBossLocations() {
    allLocations := []
    for level, locations in WildBossLocations {
        for location in locations {
            allLocations.Push(location)
        }
    }
    return allLocations
}

; 检查地点是否存在
HasWildBossLocation(location) {
    allLocations := GetAllWildBossLocations()
    for loc in allLocations {
        if (loc = location) {
            return true
        }
    }
    return false
}